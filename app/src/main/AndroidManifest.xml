<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Optional "while app is open" rules: user grants this in
         Settings > Apps > Special app access > Usage access. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Shizuku transport: the user starts Shizuku once per boot, on-device via wireless
         debugging or from adb, and approves this app in Shizuku's own dialog. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <!--
            The rule picker lists apps the user could write a rule for, which means apps with a
            launcher entry and nothing more. Declaring that intent is enough for
            queryIntentActivities to return them, so the app does not need QUERY_ALL_PACKAGES —
            a restricted permission Play grants only to a short list of app types, none of which
            this is. Notification rules do not depend on visibility at all: a listener is handed the
            posting package whether or not the app can see it.
        -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!--
        Backup is off deliberately. Everything this app stores is either device-specific — which
        renderer reached the array, what the LEDs were last told to show — or the names of chats
        seen on this phone, and the default backup would carry those names into a Google account
        backup and onto the next device. Nothing here is worth restoring elsewhere, and "stays on
        the device" should be true rather than nearly true.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_hilight_studio"
        android:roundIcon="@mipmap/ic_hilight_studio"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.HiLightStudio">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-pressing the Quick Settings tile lands here; without this filter the system has
                 nowhere to send the gesture and it does nothing. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Quick Settings tile: toggle the array without opening the app -->
        <service
            android:name=".HiLightTile"
            android:exported="true"
            android:icon="@drawable/hilight_logo"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Per-app notification triggers -->
        <service
            android:name=".NotificationTrigger"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- "While app is open" triggers -->
        <service
            android:name=".ForegroundWatcher"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Drives the HiLight LEDs from the foreground app" />
        </service>
    </application>
</manifest>
