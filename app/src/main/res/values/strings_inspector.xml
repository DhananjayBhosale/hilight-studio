<?xml version="1.0" encoding="utf-8"?>
<!--
    The notification inspector, and the foreground watcher's ongoing notification.

    **Privacy:** no message text may appear in any string here, and none may appear in the export
    the inspector builds. The inspector exists to be pasted into a bug report, which makes it the
    one place where a private message would end up in a stranger's inbox. Every string below talks
    about names, ids and structure; a translation must not invite message text in either.

    Shared vocabulary lives in strings_common.xml and is reused rather than repeated: the dialog
    dismiss button is common_close, and an empty field reads as common_none.

    Format strings use positional arguments (%1$s, not %s), because Japanese orders them
    differently from English. Nothing that is not read by a person belongs here: the JSON keys in
    peeksToJson, the clipboard label, the MIME type and the notification channel id are all
    deliberately left as literals in code.
-->
<resources>

    <!-- The dialog frame -->
    <string name="inspector_title">Notification inspector</string>
    <string name="inspector_copy_json">Copy as JSON</string>
    <string name="inspector_send">Send</string>

    <!-- Shown at the top of the dialog, and passed into inspector_export_note so the same promise
         travels with the exported data. Changing one changes both, which is the point. -->
    <string name="inspector_privacy_note">Names, ids and structure only. Message text is never shown here and never exported.</string>

    <!-- How many notifications are listed. Two forms rather than a plural, because the singular
         drops the count and the ordering clause entirely. %1$d is the number of notifications. -->
    <string name="inspector_seen_one">The last notification HiLight saw.</string>
    <string name="inspector_seen_many">The last %1$d notifications HiLight saw, newest first.</string>

    <!-- The export. This is the human-readable `note` value inside the JSON, and the only
         user-facing prose in it — every key around it stays a literal in code, because the keys are
         a diagnostic format rather than something a person reads. %1$s is inspector_privacy_note. -->
    <string name="inspector_export_note">HiLight notification inspector, newest first. %1$s</string>
    <string name="inspector_copied_toast">Copied as JSON</string>
    <string name="inspector_share_chooser_title">Send inspector output</string>

    <!-- Before any notification has arrived -->
    <string name="inspector_empty_title">Nothing seen yet</string>
    <string name="inspector_empty_body">Notifications appear here as they arrive, so leave this open — or reopen it once one has landed.</string>
    <string name="inspector_empty_access">Nothing is seen at all without notification access. The list is kept in memory only, so it empties whenever HiLight stops.</string>

    <!-- The pill on each card: whether HiLight found a name to match a per-chat rule against. A
         failed read is its own state rather than "no name", because the advice for each is the
         opposite of the other's. -->
    <string name="inspector_pill_read_failed">could not read</string>
    <string name="inspector_pill_name_found">name found</string>
    <string name="inspector_pill_no_name">no name</string>

    <!-- One line per field the matcher reads. Each line is a whole format string rather than a
         label plus a value, because a Japanese label takes a particle where English takes a colon,
         and only the translator can decide which. %1$s is the value the app supplied, or
         common_none where it supplied nothing.

         MessagingStyle is the exception: its value is one of two fixed states rather than anything
         from the app, so both readings are spelled out in full and the translator is free to reword
         the whole line. -->
    <string name="inspector_field_shortcut_id">Shortcut id: %1$s</string>
    <string name="inspector_field_sender">Sender: %1$s</string>
    <string name="inspector_field_conversation">Conversation: %1$s</string>
    <string name="inspector_field_title">Title: %1$s</string>
    <string name="inspector_field_messaging_style_detected">MessagingStyle: detected</string>
    <string name="inspector_field_messaging_style_not_detected">MessagingStyle: not detected</string>

    <!-- What the fields above mean, said only where it is true -->
    <string name="inspector_read_failed_note">This notification could not be read, so the fields below are missing rather than absent. That is a fault worth reporting with this output attached.</string>
    <string name="inspector_group_summary">Group summary, which HiLight ignores so a chat cannot fire twice.</string>
    <string name="inspector_no_name_note">This app gave no name to match on, so no per-chat rule can be written from it. A rule for the whole app still works.</string>

    <!-- The foreground watcher's ongoing notification, and the channel it sits on. The channel name
         is the label a person reads in the system notification settings, so it is translated; the
         channel id it is registered under is not read by anyone and stays a literal in code.

         Named for the watcher rather than for services in general, because these files are merged
         and a second service would otherwise want the same name.

         service_watcher_title repeats app_name deliberately rather than pointing at it, so this
         notification can be reworded without renaming the app. -->
    <string name="service_watcher_channel_name">HiLight app watcher</string>
    <string name="service_watcher_title">HiLight+</string>
    <string name="service_watcher_text">Watching for apps with light rules</string>

</resources>
