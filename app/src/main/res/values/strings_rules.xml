    <!-- Timing -->
    <string name="charging_duration_warn_first_title">Longer than 30 seconds?</string>
    <string name="charging_duration_warn_first_body">The gauge would keep the array lit for that long every time the charger goes in, which is far beyond what stock HiLight does.</string>
    <string name="charging_duration_warn_second_title">Are you sure?</string>
    <string name="charging_duration_warn_second_body">With repeats on, the LEDs could be lit for a large share of every charge. You can turn this back down at any time.</string>
