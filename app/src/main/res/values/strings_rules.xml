<?xml version="1.0" encoding="utf-8"?>
<!--
    The per-app rules screen and the chat picker that sits in front of it.

    Two prefixes: rules_* is the rules screen, its app picker and its editor; chat_* is the scope
    chooser and the conversation picker. Shared vocabulary is not repeated here — pattern names, cycle
    meanings, duration units, the percentage and the buttons every screen uses all live in
    strings_common.xml.

    Format strings are positional (%1$s, not %s), because Japanese puts the parts in a different
    order. Several of these were built by concatenating fragments in Kotlin and are single format
    strings now for the same reason. Nothing that is not read by a person belongs here: the log lines,
    the JSON keys, the messaging package list and the catch-all package sentinel are all still
    literals in code.
-->
<resources>

    <!-- The screen itself -->
    <string name="rules_section_title">Per-app rules</string>
    <string name="rules_intro_apps">Choose an app, then what HiLight does when it notifies you — or while it is open.</string>
    <string name="rules_intro_messaging">Messaging apps go one step further: a colour for a single contact or chat.</string>
    <string name="rules_add">Add app rule</string>

    <!-- One rule card. The summary line is "pattern · when it fires": %1$s is a pattern name from
         strings_common.xml or rules_random_colour, %2$s one of the two trigger phrases below. Those
         phrases are lower case here and capitalised in the editor's selector, so they are separate
         strings rather than one reused in both places. -->
    <string name="rules_card_summary">%1$s · %2$s</string>
    <string name="rules_random_colour">Random colour</string>
    <string name="rules_trigger_notification_short">on notification</string>
    <string name="rules_trigger_foreground_short">while open</string>

    <!-- "Matched", not "fired": a rule matches even when a guard swallowed the flash. %1$s is a
         relative stamp from the chat_ago_* forms at the bottom of this file. -->
    <string name="rules_last_matched">Last matched %1$s</string>
    <string name="rules_not_matched_yet">Not matched yet</string>

    <!-- Said of a rule that also covers what the person says in groups, beside their own chat -->
    <string name="rules_badge_groups_too">Groups too</string>

    <!-- The app picker. "Any app" is HiLight's own name for the catch-all, not an app label. -->
    <string name="rules_picker_title">Choose an app</string>
    <string name="rules_picker_search">Search</string>
    <string name="rules_any_app">Any app</string>
    <string name="rules_any_app_caption">Catch-all for apps without their own rule</string>

