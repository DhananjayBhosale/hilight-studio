    <string name="adb_verify_note">ヘルパーはバックグラウンドで動作し、出力はログに書き込まれるため、通常このコマンドは何も表示しません。LED アレイの反応またはヘルパーログで起動を確認してください。</string>
    <!-- "Send to computer" -->
    <string name="adb_send">パソコンに送る</string>
    <!-- "Send command" -->
    <string name="adb_share_title">コマンドを送信</string>

