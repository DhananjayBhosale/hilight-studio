<?xml version="1.0" encoding="utf-8"?>
<!--
    Japanese. English source quoted above each entry. Terms follow docs/i18n/ja-glossary.md.

    Android's own Japanese is used for the system features this screen talks about: サイレントモード for
    Do Not Disturb, バッテリーセーバー for Battery Saver, ワイヤレスデバッグ for Wireless debugging, and
    通知へのアクセス / 使用状況へのアクセス for the two special accesses, so that the wording matches the
    Settings screens these buttons open.

    The adb command lines themselves are constants in code and appear untranslated between these
    captions, which is why the ADB card's prose refers to "1 行目" rather than quoting the command.
-->
<resources>

    <!-- Auto-off -->
    <!-- "Auto-off" -->
    <string name="setup_auto_off_title">自動オフ</string>
    <!-- "The always-on look switches itself off after this. App rules still work." -->
    <string name="setup_auto_off_body">常時点灯スタイルはこの時間が過ぎると自動でオフになります。アプリ別ルールはそのまま動作します。</string>
    <!-- "Hardware protection is always on: brightness eases down after 10s of unbroken light, and the
         array rests if it has been lit for more than half of the last 10 minutes." -->
    <string name="setup_auto_off_protection">ハードウェア保護は常に有効です。10 秒続けて点灯すると明るさが徐々に下がり、直近 10 分のうち半分以上点灯していた場合は LED アレイが休止します。</string>
    <!-- "Stay on for" -->
    <string name="setup_stay_on_for">点灯時間</string>

    <!-- The two-step warning before the array may stay lit for minutes at a time -->
    <!-- "Allow up to 5 minutes" -->
    <string name="setup_allow_five_minutes">最大 5 分まで許可</string>
    <!-- "Longer than 30 seconds?" -->
    <string name="setup_warn_long_title">30 秒より長くしますか</string>
    <!-- "The LEDs draw power the whole time they are lit, and stock HiLight only flashes for a
         moment — nothing about the hardware is built for minutes of continuous light." -->
    <string name="setup_warn_long_body">LED は点灯している間ずっと電力を消費します。標準の HiLight は一瞬光るだけで、このハードウェアは数分間の連続点灯を想定して作られていません。</string>
    <!-- "Are you sure?" -->
    <string name="setup_warn_long_confirm_title">本当に設定しますか</string>
    <!-- "Up to 5 minutes of continuous illumination will cost battery, and animations freeze lit if
         the phone sleeps. You can turn this back down at any time." -->
    <string name="setup_warn_long_confirm_body">最大 5 分の連続点灯は電池を消費します。端末がスリープに入るとアニメーションは点灯したまま停止します。設定はいつでも戻せます。</string>

    <!-- When to stay dark -->
    <!-- "When to stay dark" -->
    <string name="setup_dark_title">消灯する条件</string>
    <!-- "Only while the screen is off" -->
    <string name="setup_screen_off_only">画面消灯時のみ</string>
    <!-- "From %1$s" — %1$s is a 24-hour clock time -->
    <string name="setup_quiet_from">開始 %1$s</string>
    <!-- "Until %1$s" -->
    <string name="setup_quiet_until">終了 %1$s</string>
    <!-- "Dim instead of dark" -->
    <string name="setup_quiet_dim">消灯せずに暗くする</string>
    <!-- "Dim to" -->
    <string name="setup_dim_to">明るさ</string>
    <!-- "Respect Do Not Disturb" -->
    <string name="setup_respect_dnd">サイレントモードに従う</string>
    <!-- "Pause in Battery Saver" -->
    <string name="setup_pause_saver">バッテリーセーバー中は停止</string>
    <!-- "Pause on low battery" -->
    <string name="setup_pause_low_battery">電池残量が少ないときは停止</string>
    <!-- "Pause below" -->
    <string name="setup_pause_below">停止する残量</string>
    <!-- "Ignored while charging. Battery Saver pauses it either way." -->
    <string name="setup_battery_note">充電中は適用されません。バッテリーセーバー中はいずれの場合も停止します。</string>

    <!-- "%1$d%%" -->
    <string name="setup_percent">%1$d%%</string>

