    <string name="rules_last_matched">最終一致 %1$s</string>
    <!-- "Not matched yet" -->
    <string name="rules_not_matched_yet">まだ一致なし</string>
    <string name="rules_text_priority_hint">通知テキスト · 最初に一致したルールを使用</string>
    <string name="rules_match_contains">「%1$s」を含む</string>
    <string name="rules_match_contact_text">%1$s · 「%2$s」を含む</string>
    <string name="rules_match_any_app">個別ルールのないアプリ</string>
    <string name="rules_default">デフォルト</string>
    <string name="rules_match_all_notifications">すべての通知</string>
    <string name="rules_all_other_notifications">その他すべての通知</string>
    <string name="rules_match_while_open">%1$s の表示中</string>
    <string name="rules_visual_summary">%1$s · %2$s · %3$d%%</string>
    <string name="rules_visual_summary_random">ランダムな色 · %1$s · %2$s · %3$d%%</string>
    <string name="rules_test_preview">このパターンをテスト</string>
    <string name="rules_more">その他のルール操作</string>
    <string name="rules_duplicate">複製</string>
    <string name="rules_move_earlier">優先順位を上げる</string>
    <string name="rules_move_later">優先順位を下げる</string>

    <!-- Said of a rule that also covers what the person says in groups, beside their own chat. A pill,
         so it is the shortest faithful rendering. -->
    <!-- "Groups too" -->
    <string name="rules_badge_groups_too">グループも</string>

    <!-- The app picker. "Any app" is HiLight's own name for the catch-all, so すべてのアプリ rather
         than 任意のアプリ, which would collide with 任意 as used for "optional". -->
    <!-- "Choose an app" -->
    <string name="rules_picker_title">アプリを選択</string>
    <!-- "Search" -->
    <string name="rules_picker_search">検索</string>
    <!-- "Any app" -->
    <string name="rules_any_app">すべてのアプリ</string>
    <!-- "Catch-all for apps without their own rule" -->
    <string name="rules_any_app_caption">個別のルールがないアプリすべてに適用されます。</string>

    <!-- The editor. %1$s is the app, %2$s the chat. The › is punctuation and stays. -->
    <!-- "%1$s › %2$s" -->
    <string name="rules_editor_title_chat">%1$s › %2$s</string>
    <string name="rules_editor_title_text">%1$s › 通知テキスト</string>
    <string name="rules_match_section">一致条件</string>
    <string name="rules_text_condition_label">通知に含まれる文字</string>
    <string name="rules_text_condition_hint">Android が公開するタイトル、送信者またはチャット名、通知本文を確認します。大文字と小文字は区別しません。</string>
    <string name="rules_text_check_no_recent">確認できるこのアプリの最近の通知はまだありません。</string>
    <string name="rules_text_check_private">最近の通知では、検索できるタイトル、送信者、チャット名、メッセージ本文が公開されていませんでした。</string>
    <plurals name="rules_text_check_matches">
        <item quantity="other">最近の通知 %1$d 件に一致します。</item>
    </plurals>
    <string name="rules_text_check_none">最近の通知にはこの文字列と一致するものがありません。</string>
    <string name="rules_editor_foreground_match">%1$s が画面に表示されている間に一致します。</string>
    <string name="rules_editor_all_notifications_match">%1$s の通知のうち、より具体的なルールに一致しなかったものに適用します。</string>
    <string name="rules_editor_any_app_match">有効なアプリ全体ルールがないアプリの通知に一致します。</string>
    <!-- "Per-chat rules fire on notifications." -->
    <!-- "On notification" -->
    <!-- "While open" — the same wording setup_usage_body quotes as 「アプリ表示中」ルール -->
    <!-- "Random colour each time" -->
    <string name="rules_random_colour_each_time">毎回ランダムな色</string>
    <!-- "This chat is a group, so anything posted in it fires the rule." -->
    <string name="rules_chat_is_group">このチャットはグループのため、ここでの投稿すべてでルールが発動します。</string>
    <!-- "Also when they post in a group" — a toggle label beside a switch, so the subject is carried
         by the hint below rather than spelled out here -->
    <string name="rules_include_groups">グループでの発言も対象にする</string>
    <!-- "Left off, only their own chat lights this colour, so the group chatter they are part of stays
         dark." -->
    <string name="rules_include_groups_hint">オフのままにすると、その相手との個別チャットだけがこの色で点灯し、参加しているグループチャットは消灯したままになります。</string>
    <!-- "Only if it mentions (optional)" — the field's own label, so 「この語」 is the word typed into it -->
    <string name="rules_keyword_label">この語を含む場合のみ（任意）</string>
    <!-- "Only when the screen is off" -->
    <string name="rules_only_screen_off">画面消灯時のみ</string>
    <!-- "Time per cycle" -->
    <string name="rules_time_per_cycle">1 周期の時間</string>
    <!-- "Brightness" -->
    <string name="rules_brightness">明るさ</string>
    <!-- "Test on the LEDs" -->
    <string name="rules_test_on_leds">LED でテスト</string>

    <!-- Holding the array on for longer than half a minute, and the two warnings gating it. The
         wording follows the setup screen's identical pair, since it is the same guard. -->
    <!-- "Show for" -->
    <string name="rules_show_for">点灯時間</string>
    <!-- "Allow up to 1 minute" -->
    <string name="rules_allow_one_minute">最大 1 分まで許可</string>
    <!-- "Longer than 30 seconds?" -->
    <string name="rules_duration_warn_first_title">30 秒より長くしますか</string>
    <!-- "Every notification from this app would light the array for that long, which costs battery and
         is far beyond what stock HiLight does." -->
    <string name="rules_duration_warn_first_body">このアプリから通知が届くたびに、LED アレイがその時間ずっと点灯します。電池を消費し、標準の HiLight の動作をはるかに超えます。</string>
    <!-- "Are you sure?" -->
    <string name="rules_duration_warn_second_title">本当に設定しますか</string>
    <!-- "A busy app can fire often, so the LEDs may end up lit most of the time. You can turn this
         back down at any time." -->
    <string name="rules_duration_warn_second_body">通知の多いアプリでは頻繁に発動するため、LED がほとんどの時間点灯したままになることがあります。設定はいつでも戻せます。</string>

    <!-- Last thing read before Save, when the edit would land on top of another rule -->
    <!-- "An existing rule for this app already covers that, and saving will replace its settings with
         these." -->
    <string name="rules_duplicate_warning">同じ通知に一致するルールがすでにあります。保存する前に一致条件を変更してください。</string>

    <!--
        What a per-chat rule matches on, and the repair for a chat id that has gone stale.

        These three are where the feature's main diagnostic lives, so the two matchers are worded as
        opposites of one sentence: チャット ID で一致するため、…一致し続けます against
        名前で一致するため、…一致しなくなることがあります. 固定のチャット ID is kept for the capture
        card, where the id's stability is the news; here the surviving-a-rename clause says it instead.
    -->
    <!-- "Matched by chat id, which survives the chat being renamed." -->
    <string name="rules_match_by_id">チャット ID で一致するため、チャットの名前が変わっても一致し続けます。</string>
    <!-- "The stored chat id is dropped when you save, and a fresh one is learned the next time that
         chat messages." -->
    <string name="rules_match_id_dropped">保存すると保存済みのチャット ID を削除し、そのチャットから次にメッセージが届いたときに新しい ID を取得します。</string>
    <!-- "Matched by name, so renaming the chat in %1$s can stop it matching." -->
    <string name="rules_match_by_name">名前で一致するため、%1$s でチャットの名前を変更すると一致しなくなることがあります。</string>
    <!-- "Re-learn this chat" -->
    <string name="rules_relearn_chat">このチャットを再取得</string>
    <!-- "Forgets the stored chat id and matches on the name instead, taking up the new id the next time
         that chat messages — the repair for an id changed by a reinstall or a restored backup." -->
    <string name="rules_relearn_hint">保存済みのチャット ID を削除して名前で一致するようにし、そのチャットから次にメッセージが届いたときに新しい ID を取得します。再インストールやバックアップの復元で ID が変わった場合の修復手段です。</string>

    <!-- Whole app or one chat, asked before the editor opens. %1$s is the app. -->
    <!-- "What should this rule cover?" -->
    <string name="chat_scope_title">%1$s にルールを追加</string>
    <!-- "All notifications from %1$s" -->
    <string name="chat_scope_whole_app">すべての通知</string>
    <!-- "Any chat, any sender." -->
    <string name="chat_scope_whole_app_hint">より具体的なルールに一致しなかった通知のフォールバックとして使います。</string>
    <!-- "One contact or chat" -->
    <string name="chat_scope_one_chat">特定の連絡先またはチャット</string>
    <!-- "A colour for them alone, chosen from the chats HiLight has seen." -->
    <string name="chat_scope_one_chat_hint">特定の相手や会話に専用のライトを設定します。</string>
    <string name="rules_scope_text">通知に特定の文字を含む</string>
    <string name="rules_scope_text_hint">「urgent」「invoice」や人の名前など、単語やフレーズで一致させます。</string>
    <string name="rules_scope_foreground">%1$s の表示中</string>
    <string name="rules_scope_foreground_hint">アプリが画面に表示されている間、エフェクトを表示します。</string>

    <!-- The chat picker. %1$s is the app throughout. "Seen" is 検出した rather than 見た, and stays
         distinct from the setup screen's 記憶した, which is what the list does with them afterwards. -->
    <!-- "Choose a chat" -->
    <string name="chat_picker_title">チャットを選択</string>
    <!-- "Which chat in %1$s this rule watches." -->
    <string name="chat_picker_intro">このルールが監視する %1$s のチャットを選びます。</string>
    <!-- "Chats HiLight has seen, newest first." -->
    <string name="chat_seen_list_header">HiLight が検出したチャットを新しい順に表示しています。</string>
    <!-- "No chats to list yet: HiLight has not seen a message from %1$s." -->
    <string name="chat_no_chats_yet">表示できるチャットはまだありません。HiLight は %1$s からのメッセージを検出していません。</string>
    <!-- "Group" — a pill beside a chat name, so there is no shorter form to take -->
    <string name="chat_badge_group">グループ</string>
    <!-- "Last message %1$s" -->
    <string name="chat_last_message">最終メッセージ %1$s</string>

    <!-- The two paths that work before anything has been learned -->
    <!-- "Learn the next message" -->
    <string name="chat_learn_next">次のメッセージから取得</string>
    <!-- "The surest way. The name comes from a real notification, so it is exactly what HiLight
         compares against later." -->
    <string name="chat_learn_next_hint">最も確実な方法です。実際の通知から名前を取得するため、HiLight が後で比較する文字列とまったく同じになります。</string>
    <!-- "Pick from contacts" -->
    <string name="chat_pick_contact">連絡先から選択</string>
    <!-- "Opens the system picker, so HiLight reads only the contact you tap and never your address
         book. If the app shows a different name for them, the rule can miss." -->
    <string name="chat_pick_contact_hint">システムの選択画面を開きます。HiLight はタップした連絡先だけを読み取り、アドレス帳全体を読み取ることはありません。アプリ側で別の名前が表示されている場合、ルールが一致しないことがあります。</string>

    <!-- Waiting for a message to arrive, and the chat that arrived. %1$s is the app, then the chat. -->
    <!-- "Listening" — a pill, and the sentence under it says what is being waited for -->
    <string name="chat_listening">待機中</string>
    <!-- "Waiting for the next message from %1$s…" -->
    <string name="chat_waiting">%1$s からの次のメッセージを待っています…</string>
    <!-- "Open the chat you want and send something, or wait for them to write." -->
    <string name="chat_waiting_hint">対象のチャットを開いて何か送信するか、相手からのメッセージを待ってください。</string>
    <!-- "Stop waiting" -->
    <string name="chat_stop_waiting">待機を停止</string>
    <!-- "Captured: %1$s — use this?" — the colon and dash become Japanese sentence breaks -->
    <string name="chat_captured">%1$s を取得しました。これを使いますか</string>
    <!-- "This chat came with a stable id, so renaming it will not break the rule." -->
    <string name="chat_captured_has_id">このチャットには固定のチャット ID が付いていたため、名前を変更してもルールは動作し続けます。</string>
    <!-- "No chat id came with it, so the rule will match on the name." -->
    <string name="chat_captured_no_id">チャット ID は付いていなかったため、ルールは名前で一致します。</string>
    <!-- "Use this chat" — shares a row with the button below, and ButtonLabel does not wrap, so it is
         the short form the question above it already makes specific -->
    <string name="chat_use_this">これを使う</string>
    <!-- "Wait for another" -->
    <string name="chat_wait_another">もう一度待つ</string>

    <!-- Shown instead of the wait when the notification listener is switched off. Saying 待機中 over a
         listener the system has disabled is the most misleading thing this dialog could do, so the
         pill says plainly that the wait cannot happen. -->
    <!-- "Not listening" -->
    <string name="chat_not_listening">待機できません</string>
    <!-- "HiLight cannot watch for the next message yet." -->
    <string name="chat_no_access_title">HiLight はまだ次のメッセージを待てません。</string>
    <!-- "Without notification access HiLight sees no notifications at all, and Android withdraws that
         access on its own once an app has gone unused for a while." -->
    <string name="chat_no_access_body">通知へのアクセスがないと、HiLight は通知をまったく受け取れません。また Android は、アプリが一定期間使われないとこのアクセスを自動的に取り消します。</string>
    <!-- "Open notification access" -->
    <string name="chat_open_notification_access">通知へのアクセスを開く</string>

    <!-- Told when a chat or a contact cannot be turned into a rule at all -->
    <!-- "That contact had no name to read. Try one of the other two ways." -->
    <string name="chat_contact_no_name">その連絡先から読み取れる名前がありませんでした。他の 2 つの方法を試してください。</string>
    <!-- "That chat has no name HiLight can compare and no stable id either, so a rule for it could
         never fire. A rule for the whole app still works." -->
    <string name="chat_unusable">そのチャットには HiLight が比較できる名前も固定のチャット ID もないため、ルールを作っても発動しません。アプリ全体を対象にするルールなら動作します。</string>

    <!--
        How long ago a chat last spoke, or a rule last matched.

        These are read as the value half of 最終メッセージ %1$s and 最終一致 %1$s, so they are compact
        noun phrases with no space between number and unit, exactly as the duration resources in
        strings_common.xml are.
    -->
    <!-- "just now" -->
    <string name="chat_ago_just_now">たった今</string>
    <!-- "over a week ago" -->
    <string name="chat_ago_over_a_week">1週間以上前</string>
    <!-- No usable stamp: never seen, or a stamp that did not survive being stored -->
    <!-- "a while ago" -->
    <string name="chat_ago_unknown">しばらく前</string>

    <!-- Japanese has only the "other" quantity class, so each plurals carries that item alone. The
         English "one" forms have nowhere to go here and are not written. -->
    <!-- "%1$d min ago" -->
    <plurals name="chat_ago_minutes">
        <item quantity="other">%1$d分前</item>
    </plurals>

    <!-- "%1$d hours ago" -->
    <plurals name="chat_ago_hours">
        <item quantity="other">%1$d時間前</item>
    </plurals>

    <!-- One day is its own word rather than a count of one, which is exactly why the source keeps it
         out of the plurals: with only an "other" class there would be nowhere to put it. -->
    <!-- "yesterday" -->
    <string name="chat_ago_yesterday">昨日</string>
    <!-- "%1$d days ago" -->
    <plurals name="chat_ago_days">
        <item quantity="other">%1$d日前</item>
    </plurals>

    <string name="rules_deleted">ルールを削除しました</string>
    <string name="rules_undo">元に戻す</string>
</resources>

