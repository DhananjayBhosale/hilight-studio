    <string name="chat_unusable">そのチャットには HiLight が比較できる名前も固定のチャット ID もないため、ルールを作っても発動しません。アプリ全体を対象にするルールなら動作します。</string>

    <!--
        How long ago a chat last spoke, or a rule last matched.

        These are read as the value half of 最終メッセージ %1$s and 最終一致 %1$s, so they are compact
        noun phrases with no space between number and unit, exactly as the duration resources in
        strings_common.xml are.
    -->
    <!-- "just now" -->
    <string name="chat_ago_just_now">たった今</string>
    <!-- "over a week ago" -->
    <string name="chat_ago_over_a_week">1週間以上前</string>
    <!-- No usable stamp: never seen, or a stamp that did not survive being stored -->
    <!-- "a while ago" -->
    <string name="chat_ago_unknown">しばらく前</string>

    <!-- Japanese has only the "other" quantity class, so each plurals carries that item alone. The
         English "one" forms have nowhere to go here and are not written. -->
    <!-- "%1$d min ago" -->
    <plurals name="chat_ago_minutes">
        <item quantity="other">%1$d分前</item>
    </plurals>

    <!-- "%1$d hours ago" -->
    <plurals name="chat_ago_hours">
        <item quantity="other">%1$d時間前</item>
    </plurals>

    <!-- One day is its own word rather than a count of one, which is exactly why the source keeps it
         out of the plurals: with only an "other" class there would be nowhere to put it. -->
    <!-- "yesterday" -->
    <string name="chat_ago_yesterday">昨日</string>
    <!-- "%1$d days ago" -->
    <plurals name="chat_ago_days">
        <item quantity="other">%1$d日前</item>
    </plurals>

