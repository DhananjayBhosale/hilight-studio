# Launched by class name from adb/root app_process; there is no Java call site for R8 to follow.
-keep class com.hilight.core.AdbHelper {
    public static void main(java.lang.String[]);
}

# Instantiated by Shizuku using the configured class name and no-argument constructor.
-keep class com.grimxero.hilightplus.HiLightUserService {
    public <init>();
    public *;
}
